generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  bio       String?
  skills    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects  Project[]             @relation("ProjectOwner")
  collaborations ProjectCollaborator[]
  refreshTokens  RefreshToken[]
  savedRoles     SavedRole[]
  applications   Application[]
  chatMessages   ChatMessage[]
}

model Project {
  id            String        @id @default(uuid())
  title         String
  description   String
  companyName   String?
  category      String?
  location      String        @default("Remote")
  employment    String?
  workType      String        @default("Remote")
  extraMembers  Int           @default(0)
  tags          String[]      @default([])
  coverImageUrl String?
  ownerId       String

  owner         User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  collaborators ProjectCollaborator[]
  roles         Role[]
  chatMessages  ChatMessage[]

  status        ProjectStatus         @default(RECRUITING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String
  senderId  String
  message   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Role {
  id           String        @id @default(uuid())
  projectId    String
  title        String
  compType     String?       // e.g. "Equity", "Revenue-share", "Hourly", "Paid"
  compValue    String?       // e.g. "1.5%", "3%", "$50/hr"
  employment   String?       // e.g. "Full-time", "Part-time", "Contract"
  contractType String?       // Legacy / alternative alias
  compensation String?       // Legacy / alternative alias
  totalSpots   Int           @default(1)
  filledSpots  Int           @default(0)
  description  String?
  requirements String[]      @default([])

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedRole[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt @default(now())
}

model Application {
  id           String            @id @default(uuid())
  roleId       String
  applicantId  String
  coverNote    String?
  portfolioUrl String?
  counterOffer String?
  counterStart DateTime?
  status       ApplicationStatus @default(PENDING)

  role         Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([roleId, applicantId])
}

model SavedRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model ProjectCollaborator {
  id        String           @id @default(uuid())
  projectId String
  userId    String
  title     String?          // e.g. "Co-founder, Product", "Lead Frontend", "Designer"
  role      CollaboratorRole @default(EDITOR)

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  RECRUITING
  HIRING
  IN_PROGRESS
  CLOSED
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}
